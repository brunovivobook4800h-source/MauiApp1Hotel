<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1Hotel.Views.Sobre"
             Title="Sobre"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>
        <VerticalStackLayout Padding="25"
                             Spacing="20"
                             VerticalOptions="Center">

            <!-- Cabeçalho -->
            <VerticalStackLayout Spacing="10"
                                 HorizontalOptions="Center">

                <Label Text="HOTEL RESERVA"
                       FontSize="28"
                       FontAttributes="Bold"
                       TextColor="{StaticResource Primary}"
                       HorizontalTextAlignment="Center" />

                <Label Text="Sobre o Aplicativo"
                       FontSize="18"
                       TextColor="{StaticResource Gray900}"
                       HorizontalTextAlignment="Center" />

                <Label Text="Sua estadia começa aqui."
                       FontSize="14"
                       TextColor="{StaticResource Gray500}"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

            <!-- Informações do aplicativo -->
            <Border Padding="20"
                    Stroke="{StaticResource Gray300}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 12"
                    BackgroundColor="White">

                <VerticalStackLayout Spacing="18">

                    <Label Text="INFORMAÇÕES"
                           FontSize="14"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}" />

                    <Label Text="Desenvolvedor"
                           FontSize="13"
                           TextColor="{StaticResource Gray500}" />

                    <Label Text="Bruno dos Santos Evaristo"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray200}" />

                    <Label Text="Ano de Desenvolvimento"
                           FontSize="13"
                           TextColor="{StaticResource Gray500}" />

                    <Label Text="2026"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray200}" />

                    <Label Text="Tecnologias Utilizadas"
                           FontSize="13"
                           TextColor="{StaticResource Gray500}" />

                    <Label Text=".NET MAUI, C# e XAML"
                           FontSize="16"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Gray900}" />

                    <BoxView HeightRequest="1"
                             Color="{StaticResource Gray200}" />

                    <Label Text="Descrição"
                           FontSize="13"
                           TextColor="{StaticResource Gray500}" />

                    <Label Text="Aplicativo acadêmico para simulação de reservas de hospedagem, desenvolvido na disciplina de Desenvolvimento de Sistemas II."
                           FontSize="14"
                           TextColor="{StaticResource Gray900}" />

                </VerticalStackLayout>

            </Border>

            <!-- Botão de retorno -->
            <Button Text="Voltar"
                    Clicked="OnVoltarClicked"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    HeightRequest="50" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
